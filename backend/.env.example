############################################################
# WhatsApp AI Assistant - Environment Configuration Example
# Copy this file to ".env" and fill in real values.
# NEVER commit the real ".env" file to version control.
############################################################

# ------------------------------------------------------------------
# Application
# ------------------------------------------------------------------
APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_DEBUG=false
APP_SECRET_KEY=change-this-to-a-long-random-secret-string

# ------------------------------------------------------------------
# WhatsApp Business Cloud API (Meta)
# ------------------------------------------------------------------
# Permanent or long-lived access token generated in Meta Developer Console
WHATSAPP_ACCESS_TOKEN=your_whatsapp_cloud_api_access_token
# Phone Number ID from Meta WhatsApp Cloud API dashboard
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
# Business Account ID (optional, used for some management calls)
WHATSAPP_BUSINESS_ACCOUNT_ID=your_business_account_id
# Custom string you choose; must match the value entered in Meta webhook setup
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
# App secret from Meta App Dashboard, used to verify X-Hub-Signature-256
WHATSAPP_APP_SECRET=your_meta_app_secret
# Cloud API version to call, e.g. v20.0
WHATSAPP_API_VERSION=v20.0
# Owner's own WhatsApp number (with country code, no +) used to detect human override
OWNER_WHATSAPP_NUMBER=15551234567

# ------------------------------------------------------------------
# OpenRouter (AI Provider)
# ------------------------------------------------------------------
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Primary model used for all AI replies
OPENROUTER_PRIMARY_MODEL=openai/gpt-oss-120b
# Fallback model used automatically if the primary model fails/times out
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-20b
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=3
OPENROUTER_TEMPERATURE=0.7
OPENROUTER_MAX_TOKENS=800
# Optional headers OpenRouter recommends for attribution/rankings
OPENROUTER_SITE_URL=https://example.com
OPENROUTER_SITE_NAME=WhatsApp AI Assistant

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DATABASE_URL=sqlite:///./data/contacts.db

# ------------------------------------------------------------------
# Admin / Security
# ------------------------------------------------------------------
# Comma-separated list of WhatsApp numbers allowed to issue admin commands
ADMIN_NUMBERS=15551234567
# Shared secret required for any internal/management HTTP endpoints.
# Also used as the admin dashboard's login key (X-Admin-Key header).
INTERNAL_API_KEY=change-this-internal-api-key
# Comma-separated origins allowed to call /admin/* from a browser (CORS).
# Set to your deployed dashboard URL in production.
DASHBOARD_ORIGINS=http://localhost:5173

# ------------------------------------------------------------------
# Rate Limiting
# ------------------------------------------------------------------
RATE_LIMIT_MESSAGES_PER_MINUTE=10
RATE_LIMIT_COOLDOWN_SECONDS=60

# ------------------------------------------------------------------
# Spam Detection
# ------------------------------------------------------------------
SPAM_REPEAT_THRESHOLD=4
SPAM_WINDOW_SECONDS=30
SPAM_MUTE_MINUTES=15

# ------------------------------------------------------------------
# Human Override
# ------------------------------------------------------------------
HUMAN_OVERRIDE_TIMEOUT_MINUTES=30

# ------------------------------------------------------------------
# Typing Delay
# ------------------------------------------------------------------
TYPING_DELAY_MIN_SECONDS=2
TYPING_DELAY_MAX_SECONDS=5

# ------------------------------------------------------------------
# AI Voice Reply (optional Text-to-Speech) - uses OpenRouter's
# /audio/speech endpoint with the SAME OPENROUTER_API_KEY/
# OPENROUTER_BASE_URL configured above for chat. No separate provider or
# API key. Feature is OFF by default (see data/settings.json
# "voice_reply.enabled") - these vars only supply the model choice for
# when it's turned on from the dashboard.
OPENROUTER_TTS_MODEL=openai/gpt-4o-mini-tts
TTS_TIMEOUT_SECONDS=30
# Hard ceiling (characters) on any single reply sent to the TTS endpoint,
# regardless of the dashboard's configured per-reply limit.
TTS_MAX_CHARACTERS=1200

# ------------------------------------------------------------------
# Incoming voice messages (Speech-to-Text) - uses OpenRouter's
# /audio/transcriptions endpoint with the same OPENROUTER_API_KEY. OFF by
# default: existing behavior (voice notes are received but not
# transcribed/answered) is unchanged until explicitly enabled.
VOICE_INPUT_ENABLED=false
OPENROUTER_STT_MODEL=openai/whisper-large-v3
VOICE_MAX_DURATION_SECONDS=120
VOICE_MAX_FILE_SIZE_MB=16
VOICE_TRANSCRIPTION_TIMEOUT=30
# Whether the transcribed text is stored in Conversation History like a
# normal text message (so the contact and owner can see what was heard).
SAVE_TRANSCRIPTION=true

# ------------------------------------------------------------------
# Web search (see web_search.py). Empty by default - NO search provider
# is implemented in this codebase yet. Leaving these blank is safe: the
# AI will tell people web search isn't available rather than fake a
# search. See web_search.py's module docstring for exactly what to add
# to make this real (any HTTP search API works - Serper.dev, Bing Web
# Search, Google Programmable Search, etc).
WEB_SEARCH_PROVIDER=
WEB_SEARCH_API_KEY=

# ------------------------------------------------------------------
# Conversation Memory
# ------------------------------------------------------------------
MEMORY_MAX_MESSAGES=20
MEMORY_MAX_CHARACTERS=6000

# ------------------------------------------------------------------
# Smart Memory (independent from Conversation Memory - see smart_memory.py)
# ------------------------------------------------------------------
# Prompt budget: max number of Smart Memory facts / max characters of
# Smart Memory text injected into the AI prompt per request.
SMART_MEMORY_MAX_ITEMS=15
SMART_MEMORY_MAX_CHARACTERS=2000
# Use the configured AI model to extract structured facts from messages.
# If false (or if the AI call fails), a deterministic regex-based
# extractor is used instead as a fallback.
SMART_MEMORY_AI_EXTRACTION_ENABLED=true
# Minimum confidence (0.0-1.0) for an automatically inferred memory to be
# saved. Explicit "remember ..." commands always bypass this threshold.
SMART_MEMORY_MIN_CONFIDENCE=0.55
# Default lifetime (in days) applied to Short-Term / Temporary memories
# when no explicit expiry is supplied.
SMART_MEMORY_SHORT_TERM_DAYS=14
SMART_MEMORY_TEMPORARY_DAYS=1

# ------------------------------------------------------------------
# Group Handling
# ------------------------------------------------------------------
IGNORE_GROUP_MESSAGES=true

# ------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./data/logs
LOG_FILE=app.log
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=5
